# Dependencies (installed inside Docker, never copied)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js build outputs (always generated during `next build`)
.next/
out/
dist/
build/
.vercel/

# Tests and testing output
coverage/
.nyc_output/
__tests__/
__mocks__/
playwright-report/
test-results/
.vitest/
*.test.*
*.spec.*

# Local development and editor files
.git/
.gitignore
.gitattributes
.vscode/
.idea/
*.swp
*.swo
*~
*.log

# Environment variables — pass secrets at run time with `docker run -e`.
.env
.env*.local
.env.development
.env.test
.env.production.local

# Docker configuration files
Dockerfile*
.dockerignore
compose.yaml
compose.yml
docker-compose*.yaml
docker-compose*.yml

# Documentation
*.md
docs/

# CI/CD
.github/
.gitlab-ci.yml

# Cache directories and temporary data
.cache/
.swc/
.turbo/
.tmp/
.temp/

# TypeScript build metadata
*.tsbuildinfo

# OS-specific junk
.DS_Store
._*
Thumbs.db

# AI/ML tool metadata
.cursor/
.cursorrules
AGENTS.md
.agents/
skills-lock.json
